# ---- Required -------------------------------------------------------------
# A long random string. The Relate app sends it as VIDEO_WORKER_SECRET.
# Generate one with:  openssl rand -hex 32
WORKER_SECRET=

# Groq API key for Whisper, used when a video has no captions.
# https://console.groq.com/keys  (~$0.04 per hour of audio with the turbo model)
GROQ_API_KEY=

# ---- Optional -------------------------------------------------------------
# GROQ_MODEL=whisper-large-v3-turbo      # or whisper-large-v3 (more accurate, ~$0.11/hr)
# WHISPER_LANGUAGE=en                    # blank = auto-detect
# CAPTION_LANGS=en                       # caption languages to accept, in order, e.g. en,es
# PREFER_CAPTIONS=1                      # 0 = always transcribe the audio
# MAX_DURATION_MINUTES=180
# CHUNK_MINUTES=10
# MAX_CONCURRENT_JOBS=2
# JOB_TTL_HOURS=72
# JOBS_DIR=/data/jobs
# YTDLP_AUTO_UPDATE=1                    # upgrade yt-dlp on every start

# Logged-in cookies for Facebook / Instagram / YouTube "confirm you're not a bot".
# See README.md#cookies. Easiest: paste the cookies.txt text straight in:
# COOKIES_TXT=
# or point at a file:           COOKIES_FILE=/data/cookies.txt
# or the file base64-encoded:   COOKIES_B64=
# Where the error messages send people for those instructions:
# COOKIES_HELP_URL=https://relate.click/help/video-cookies

# Route downloads through a (residential) proxy if YouTube blocks the server's IP.
# YTDLP_PROXY=http://user:pass@host:port
